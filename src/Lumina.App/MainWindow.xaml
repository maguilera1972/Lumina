<Window x:Class="Lumina.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumina.App"
        Title="Lumina — atelier laser (prévisualisation)"
        Height="920" Width="1400"
        MinHeight="700" MinWidth="1100"
        Icon="pack://application:,,,/Assets/lumina-icon.png"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        FontFamily="Segoe UI"
        FontSize="14"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Fichier">
        <MenuItem Header="_Nouveau show" Click="New_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="_Ouvrir un show…" Click="Open_Click" InputGestureText="Ctrl+O"/>
        <MenuItem Header="_Fermer le show" Click="CloseShow_Click" InputGestureText="Ctrl+W"/>
        <MenuItem Header="_Enregistrer" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Enregistrer _sous…" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="Importer un _motif ILDA / FRA…" Click="ImportPattern_Click"/>
        <MenuItem Header="Inspecter un fichier ILDA…" Click="InspectIlda_Click"/>
        <MenuItem Header="Charger l’_audio (MP3 / WAV)…" Click="LinkAudio_Click"/>
        <MenuItem Header="Convertir MRS / Mamba en ILDA…" Click="ConvertIlda_Click"/>
        <Separator/>
        <MenuItem Header="_Quitter" Click="Quit_Click"/>
      </MenuItem>
      <MenuItem Header="_Affichage">
        <MenuItem x:Name="PreviewConsoleItem" Header="Aperçu laser dans la _console" IsCheckable="True" IsChecked="True" Click="PreviewConsole_Click"/>
        <MenuItem x:Name="PreviewWindowItem" Header="Aperçu laser dans une _fenêtre séparée" IsCheckable="True" Click="PreviewWindow_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Atelier hors ligne : ouvrez ou créez un show. Aucune USB-Box n’est nécessaire pour éditer et prévisualiser."/>
      </StatusBarItem>
    </StatusBar>

    <TabControl Margin="8">
      <TabItem Header="Atelier">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="2.2*" MinHeight="200"/>
            <RowDefinition Height="90" MinHeight="72"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="*" MinHeight="110"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="0.42*" MinWidth="280" MaxWidth="380"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <local:LaserPreview x:Name="ShowPreview"/>
            <Border x:Name="EmptyOverlay" Background="{StaticResource BoothBg}" CornerRadius="16">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="Atelier Lumina" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource BoothAccent}"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BoothMuted}" Margin="0,10,0,16"
                           Text="Chargez un show, éditez la timeline et prévisualisez le laser à l’écran. La USB-Box n’est pas requise. L’audio se charge uniquement via Audio…"/>
                <WrapPanel HorizontalAlignment="Center">
                  <Button Content="Ouvrir un show…" Click="Open_Click" Padding="12,8" Margin="0,0,8,8"/>
                  <Button Content="Nouveau show" Click="New_Click" Padding="12,8" Margin="0,0,8,8"/>
                  <Button Content="Importer ILDA…" Click="ImportPattern_Click" Padding="12,8" Margin="0,0,8,8"/>
                  <Button Content="Glissez un .ild / .mrs ici" IsEnabled="False" Padding="12,8" Margin="0,0,0,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="DetachedOverlay" Visibility="Collapsed" Background="{StaticResource BoothBg}" CornerRadius="16">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Aperçu dans une fenêtre séparée" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource BoothAccent}"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource BoothMuted}" Margin="0,10,0,16"
                           Text="Le show laser s’affiche dans l’autre fenêtre. Vous pouvez la placer sur un second écran."/>
                <Button Content="Renvoyer l’aperçu à la console" Click="PreviewConsole_Click" Padding="12,8" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button x:Name="DetachPreviewButton" Content="Fenêtre séparée" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16" Padding="10,6" Click="PreviewWindow_Click" ToolTip="Afficher l’aperçu laser dans une fenêtre indépendante"/>
          </Grid>

          <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="90"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource BoothPanel}" Padding="10" Margin="0,0,0,8" CornerRadius="14">
              <StackPanel>
                <TextBlock x:Name="TitleText" Text="Aucun show" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="KindText" Foreground="{StaticResource BoothMuted}" Margin="0,2,0,6"/>
                <TextBlock x:Name="AudioText" Text="Pas d’audio" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button Content="Ouvrir" Click="Open_Click" Width="72" Margin="0,0,6,6" Padding="6"/>
                  <Button Content="Nouveau" Click="New_Click" Width="72" Margin="0,0,6,6" Padding="6"/>
                  <Button Content="Fermer" Click="CloseShow_Click" Width="72" Margin="0,0,6,6" Padding="6"/>
                  <Button Content="Audio…" Click="LinkAudio_Click" Width="72" Margin="0,0,0,6" Padding="6"/>
                </WrapPanel>
                <Button Content="Caler sur le rythme audio" Click="AlignRhythm_Click" Padding="8" Margin="0,0,0,8"/>
                <TextBlock x:Name="SyncText" TextWrapping="Wrap" Foreground="{StaticResource BoothAccent}" Margin="0,0,0,8"
                           Text="Prévisualisation écran — projecteur éteint."/>
                <WrapPanel>
                  <Button Content="Lecture" Click="Play_Click" Width="84" Margin="0,0,6,0" Padding="8,6"/>
                  <Button Content="Pause" Click="Pause_Click" Width="84" Margin="0,0,6,0" Padding="8,6"/>
                  <Button Content="Stop" Click="Stop_Click" Width="84" Padding="8,6"/>
                </WrapPanel>
                <TextBlock x:Name="TimeText" Text="00:00.0 / 00:00.0" FontFamily="Consolas" FontSize="16" Margin="0,8,0,0"/>
                <TextBlock x:Name="FrameText" Text="Frame 0 / 0" Foreground="{StaticResource BoothMuted}" Margin="0,4,0,0"/>
                <Expander Header="USB-Box (facultatif)" Margin="0,8,0,0" Foreground="{StaticResource BoothMuted}">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BoothMuted}" Margin="0,0,0,8"
                               Text="Inutile pour éditer. N’armez que lorsqu’un projecteur est prêt."/>
                    <Button x:Name="LaserArmButton" Content="LASER OFF — prévisualisation"
                            Click="LaserArm_Click" Padding="8" Margin="0,0,0,8"/>
                    <Button Content="Arrêt d’urgence (Échap)" Click="Emergency_Click" Padding="8"/>
                    <TextBlock x:Name="DacText" Text="Sortie projecteur : coupée" Foreground="{StaticResource BoothMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <local:ClipEditorView x:Name="ClipEditor" Grid.Row="1"/>
          </Grid>

          <local:WaveformView x:Name="Waveform" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8"/>
          <local:TimelineView x:Name="Timeline" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8"/>
          <local:LibraryView x:Name="Library" Grid.Row="3" Grid.ColumnSpan="2"/>
        </Grid>
      </TabItem>

      <TabItem Header="Contenu ILDA">
        <local:IldaInspector x:Name="IldaView" Margin="8"/>
      </TabItem>
      <TabItem Header="Palette couleurs">
        <local:ColorPaletteView x:Name="PaletteView" Margin="8"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
