<UserControl x:Class="Lumina.App.ColorPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.App">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.92*" MinWidth="240" MaxWidth="340"/>
      <ColumnDefinition Width="1.4*" MinWidth="260"/>
      <ColumnDefinition Width="0.85*" MinWidth="220" MaxWidth="320"/>
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource BoothPanel}" Padding="10" Margin="0,0,8,0" CornerRadius="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="PROJECTEUR" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ComboBox x:Name="ProjectorBox" Margin="0,0,0,8" SelectionChanged="Profile_Changed">
            <ComboBoxItem Content="RGB — rouge, vert, bleu"/>
            <ComboBoxItem Content="RGY — rouge, vert, jaune (pas de bleu)"/>
          </ComboBox>

          <TextBlock Text="DRIVER / DAC" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ComboBox x:Name="DriverBox" Margin="0,0,0,4" SelectionChanged="Profile_Changed">
            <ComboBoxItem Content="Prévisualisation écran"/>
            <ComboBoxItem Content="MediaLas USB-Box (FTDI ILDA)"/>
            <ComboBoxItem Content="Pangolin FB3 (USB)"/>
            <ComboBoxItem Content="Pangolin FB4 (réseau)"/>
            <ComboBoxItem Content="DAC ouvert / bridge réseau"/>
          </ComboBox>
          <TextBlock x:Name="AnalogHint" TextWrapping="Wrap" Foreground="{DynamicResource BoothAccent}" FontSize="12" Margin="0,0,0,8"
                     Text="RGB · broche 5 = rouge, 6 = vert, 7 = bleu."/>

          <TextBlock x:Name="RoutingLabel" Text="Câblage jaune" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ComboBox x:Name="RoutingBox" Margin="0,0,0,8" SelectionChanged="Profile_Changed">
            <ComboBoxItem Content="Jaune → broche ILDA bleu (USB-Box)"/>
            <ComboBoxItem Content="Jaune approximé R+V (bleu muet)"/>
          </ComboBox>

          <TextBlock Text="ESPACE DE PROJECTION" FontWeight="SemiBold" Margin="0,4,0,4"/>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BoothMuted}" FontSize="12" Margin="0,0,0,6"
                     Text="Mondes = zones indépendantes (plusieurs projecteurs ou plusieurs zones sur le même mur). L’aperçu compose les mondes actifs."/>

          <TextBlock Text="Mondes" Foreground="{DynamicResource BoothMuted}" FontSize="12"/>
          <ListBox x:Name="WorldList" Height="88" Margin="0,2,0,6" SelectionChanged="WorldList_SelectionChanged"
                   Background="#121A26" BorderBrush="#3AA8B8" BorderThickness="1"/>
          <WrapPanel Margin="0,0,0,8">
            <Button Content="Ajouter un monde" Click="AddWorld_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Retirer" Click="RemoveWorld_Click" Padding="8,5" Margin="0,0,6,6"/>
            <CheckBox x:Name="WorldEnabledBox" Content="Actif" VerticalAlignment="Center" Margin="0,0,8,6" Click="Profile_Changed"/>
          </WrapPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nom" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <TextBox x:Name="WorldNameBox" Grid.Column="1" LostFocus="WorldName_LostFocus"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projecteur #" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <ComboBox x:Name="WorldProjectorBox" Grid.Column="1" SelectionChanged="Profile_Changed">
              <ComboBoxItem Content="0 — principal / aperçu"/>
              <ComboBoxItem Content="1"/>
              <ComboBoxItem Content="2"/>
              <ComboBoxItem Content="3"/>
              <ComboBoxItem Content="4"/>
              <ComboBoxItem Content="5"/>
              <ComboBoxItem Content="6"/>
              <ComboBoxItem Content="7"/>
            </ComboBox>
          </Grid>

          <TextBox x:Name="ProfileNameBox" Margin="0,0,0,6" LostFocus="Profile_Changed" ToolTip="Nom du profil"/>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BoothMuted}" FontSize="11" Margin="0,0,0,4"
                     Text="Géométrie du monde sélectionné :"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Largeur" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="0" Grid.Column="1">
              <TextBlock x:Name="AlignWidthLabel" DockPanel.Dock="Right" Width="48" Text="100 %" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
              <Slider x:Name="AlignWidth" Minimum="0.2" Maximum="1.2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="Hauteur" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="1" Grid.Column="1">
              <TextBlock x:Name="AlignHeightLabel" DockPanel.Dock="Right" Width="48" Text="100 %" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
              <Slider x:Name="AlignHeight" Minimum="0.2" Maximum="1.2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </DockPanel>
            <TextBlock Grid.Row="2" Text="Align. X" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="2" Grid.Column="1">
              <TextBlock x:Name="AlignXLabel" DockPanel.Dock="Right" Width="48" Text="0" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
              <Slider x:Name="AlignX" Minimum="-0.5" Maximum="0.5" Value="0" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </DockPanel>
            <TextBlock Grid.Row="3" Text="Align. Y" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="3" Grid.Column="1">
              <TextBlock x:Name="AlignYLabel" DockPanel.Dock="Right" Width="48" Text="0" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
              <Slider x:Name="AlignY" Minimum="-0.5" Maximum="0.5" Value="0" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </DockPanel>
            <TextBlock Grid.Row="4" Text="Rotation" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <DockPanel Grid.Row="4" Grid.Column="1">
              <TextBlock x:Name="AlignRotLabel" DockPanel.Dock="Right" Width="48" Text="0.0°" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
              <Slider x:Name="AlignRot" Minimum="-45" Maximum="45" Value="0" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </DockPanel>
          </Grid>
          <WrapPanel Margin="0,4,0,6">
            <CheckBox x:Name="FlipXBox" Content="Miroir X" Click="Profile_Changed" Margin="0,0,12,4"/>
            <CheckBox x:Name="FlipYBox" Content="Miroir Y" Click="Profile_Changed" Margin="0,0,0,4"/>
          </WrapPanel>
          <WrapPanel>
            <Button Content="Mire d’alignement" Click="Mire_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Arrêter la mire" Click="ClearMire_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Zone 1:1" Click="ResetAlign_Click" Padding="8,5" Margin="0,0,0,6"/>
          </WrapPanel>
          <WrapPanel Margin="0,0,0,8">
            <Button Content="Enregistrer le profil…" Click="SaveProfile_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Charger un profil…" Click="LoadProfile_Click" Padding="8,5" Margin="0,0,0,6"/>
          </WrapPanel>

          <TextBlock Text="CONVERSION" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ComboBox x:Name="ModeBox" Margin="0,0,0,8" SelectionChanged="Profile_Changed">
            <ComboBoxItem Content="Direct (gains + étalonnage)"/>
            <ComboBoxItem Content="Primaire la plus proche"/>
            <ComboBoxItem Content="Mix des diodes actives"/>
            <ComboBoxItem Content="Table palette 64 couleurs"/>
          </ComboBox>

          <TextBlock Text="NIVEAUX" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Master" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="MasterGain" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            <TextBlock Grid.Row="1" Text="Rouge" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="RedGain" Minimum="0" Maximum="2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            <TextBlock Grid.Row="2" Text="Vert" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="GreenGain" Minimum="0" Maximum="2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            <TextBlock Grid.Row="3" x:Name="BlueGainLabel" Text="Bleu" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="3" Grid.Column="1" x:Name="BlueGain" Minimum="0" Maximum="2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            <TextBlock Grid.Row="4" x:Name="YellowGainLabel" Text="Jaune" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="4" Grid.Column="1" x:Name="YellowGain" Minimum="0" Maximum="2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
          </Grid>

          <StackPanel x:Name="RgyExtras" Margin="0,4,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="B→J" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" ToolTip="Bleu source → diode jaune"/>
              <Slider Grid.Row="0" Grid.Column="1" x:Name="BlueFold" Minimum="0" Maximum="2" Value="1" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
              <TextBlock Grid.Row="1" Text="R+V" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" ToolTip="Part R+V → diode jaune"/>
              <Slider Grid.Row="1" Grid.Column="1" x:Name="YellowFromRg" Minimum="0" Maximum="1" Value="0.35" VerticalAlignment="Center" ValueChanged="Profile_Changed"/>
            </Grid>
          </StackPanel>

          <Expander Header="Étalonnage diodes (0–100 %)" Margin="0,8,0,6">
            <StackPanel Margin="0,6,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BoothMuted}" FontSize="12" Margin="0,0,0,6"
                         Text="Courbes 0 / 25 / 50 / 75 / 100 % par diode."/>
              <ComboBox x:Name="CurveChannelBox" Margin="0,0,0,6" SelectionChanged="CurveChannel_Changed">
                <ComboBoxItem Content="Rouge"/>
                <ComboBoxItem Content="Vert"/>
                <ComboBoxItem Content="Bleu"/>
                <ComboBoxItem Content="Jaune"/>
              </ComboBox>
              <TextBlock Text="0 %" Foreground="{DynamicResource BoothMuted}"/>
              <Slider x:Name="Curve0" Maximum="1" ValueChanged="Curve_Changed"/>
              <TextBlock Text="25 %" Foreground="{DynamicResource BoothMuted}"/>
              <Slider x:Name="Curve25" Maximum="1" Value="0.25" ValueChanged="Curve_Changed"/>
              <TextBlock Text="50 %" Foreground="{DynamicResource BoothMuted}"/>
              <Slider x:Name="Curve50" Maximum="1" Value="0.5" ValueChanged="Curve_Changed"/>
              <TextBlock Text="75 %" Foreground="{DynamicResource BoothMuted}"/>
              <Slider x:Name="Curve75" Maximum="1" Value="0.75" ValueChanged="Curve_Changed"/>
              <TextBlock Text="100 %" Foreground="{DynamicResource BoothMuted}"/>
              <Slider x:Name="Curve100" Maximum="1" Value="1" ValueChanged="Curve_Changed"/>
              <Button Content="Réinitialiser cette courbe" Click="ResetCurve_Click" Padding="6" Margin="0,6,0,0"/>
            </StackPanel>
          </Expander>

          <CheckBox x:Name="EnabledBox" IsChecked="True" Click="Profile_Changed" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Text="Appliquer à la prévisualisation, au DAC et à l’export"/>
          </CheckBox>
          <WrapPanel>
            <Button Content="Réinit. palette 64" Click="Reset_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Preset RGB" Click="PresetRgb_Click" Padding="8,5" Margin="0,0,6,6"/>
            <Button Content="Preset RGY" Click="PresetRgy_Click" Padding="8,5" Margin="0,0,0,6"/>
          </WrapPanel>

          <TextBlock Text="MOTIFS TEST" FontWeight="SemiBold" Margin="0,4,0,6"/>
          <WrapPanel>
            <Button Content="Rouge" Click="TestRed_Click" Width="64" Margin="0,0,6,6" Padding="6"/>
            <Button x:Name="TestGreenBtn" Content="Vert" Click="TestGreen_Click" Width="64" Margin="0,0,6,6" Padding="6"/>
            <Button x:Name="TestBlueBtn" Content="Bleu" Click="TestBlue_Click" Width="64" Margin="0,0,6,6" Padding="6"/>
            <Button x:Name="TestYellowBtn" Content="Jaune" Click="TestYellow_Click" Width="64" Margin="0,0,6,6" Padding="6"/>
            <Button Content="Blanc" Click="TestWhite_Click" Width="64" Margin="0,0,6,6" Padding="6"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Column="1" Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="TABLE PALETTE (entrée ILDA → sortie projecteur)"
                 FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock DockPanel.Dock="Top" x:Name="TableHint" Foreground="{DynamicResource BoothMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                 Text="Haut : couleur source. Bas : aperçu visuel après conversion. Cliquez une case pour régler la sortie."/>
      <UniformGrid x:Name="SwatchGrid" Columns="8"/>
    </DockPanel>

    <Border Grid.Column="2" Background="{DynamicResource BoothPanel}" Padding="10" CornerRadius="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="90"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="CASE SÉLECTIONNÉE" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="EntryLabel" Text="Aucune" Margin="0,0,0,6" TextWrapping="Wrap"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Sortie R" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="OutR" Maximum="255" VerticalAlignment="Center" ValueChanged="Out_Changed"/>
            <TextBlock Grid.Row="1" Text="Sortie V" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="OutG" Maximum="255" VerticalAlignment="Center" ValueChanged="Out_Changed"/>
            <TextBlock Grid.Row="2" Text="Sortie B" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="OutB" Maximum="255" VerticalAlignment="Center" ValueChanged="Out_Changed"/>
          </Grid>
          <Rectangle x:Name="OutPreview" Height="28" Margin="0,8,0,8" Fill="#000" RadiusX="6" RadiusY="6"/>
          <TextBlock Text="BROCHES ILDA / USB-BOX" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="PinText" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource BoothAccent}" TextWrapping="Wrap"
                     Text="Pin 5 R  —&#10;Pin 6 G  —&#10;Pin 7 B  —"/>
          <TextBlock Text="Aperçu (couleur perçue)" Foreground="{DynamicResource BoothMuted}" Margin="0,8,0,6"/>
        </StackPanel>
        <local:LaserPreview x:Name="SamplePreview" Grid.Row="1"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
