<Window x:Class="Lumina.App.FrameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumina.App"
        Title="Lumina — Éditeur de frames ILDA"
        Height="780" Width="1200"
        MinHeight="520" MinWidth="800"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        Icon="pack://application:,,,/Assets/lumina-icon.png">
  <DockPanel Margin="8">
    <!-- Top: title bar with close hint -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource BoothPanel}"
            CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="StayOnTopBox" Content="Au premier plan"
                    Click="StayOnTop_Changed"
                    VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Fermer l'éditeur" Click="Close_Click" Padding="10,6"/>
        </StackPanel>
        <TextBlock Text="Éditeur de frames laser — dessinez vos motifs ILDA point par point et exportez-les dans la bibliothèque."
                   TextWrapping="Wrap" Foreground="{StaticResource BoothMuted}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Editor panel -->
    <local:FrameEditorView x:Name="Editor"/>
  </DockPanel>
</Window>
