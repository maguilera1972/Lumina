<UserControl x:Class="Lumina.App.ClipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource BoothPanel}" Padding="10" CornerRadius="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="ÉDITION DU CLIP" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="ClipLabel" Text="Sélectionnez un clip sur la timeline." TextWrapping="Wrap"
                   Foreground="{DynamicResource BoothMuted}" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Intensité" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Intensity" Maximum="2" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Teinte" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Hue" Minimum="-180" Maximum="180" Value="0" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Rouge" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Red" Maximum="2" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Rotation" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Rotation" Minimum="-180" Maximum="180" Value="0" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="Vert" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Green" Maximum="2" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="Largeur" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="WidthFx" Minimum="0.1" Maximum="3" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="0">
            <TextBlock Text="Bleu" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="Blue" Maximum="2" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2">
            <TextBlock Text="Hauteur" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="HeightFx" Minimum="0.1" Maximum="3" Value="1" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="0">
            <TextBlock Text="Décalage X" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="OffsetX" Minimum="-1" Maximum="1" Value="0" ValueChanged="Fx_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Text="Décalage Y" Foreground="{DynamicResource BoothMuted}"/>
            <Slider x:Name="OffsetY" Minimum="-1" Maximum="1" Value="0" ValueChanged="Fx_Changed"/>
          </StackPanel>
        </Grid>
        <WrapPanel Margin="0,8,0,0">
          <Button Content="Réinitialiser" Click="Reset_Click" Padding="8,4" Margin="0,0,8,0"/>
          <Button Content="Supprimer le clip" Click="Delete_Click" Padding="8,4"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
