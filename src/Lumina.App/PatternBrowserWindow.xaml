<Window x:Class="Lumina.App.PatternBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumina.App"
        Title="Lumina — bibliothèque ILDA"
        Height="820" Width="1180"
        MinHeight="500" MinWidth="760"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        Icon="pack://application:,,,/Assets/lumina-icon.png">
  <DockPanel Margin="8">
    <Border DockPanel.Dock="Top" Background="{StaticResource BoothPanel}" Padding="10,8" Margin="0,0,0,8" CornerRadius="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="StayOnTopBox" Content="Au premier plan" Click="StayOnTop_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Button Content="Renvoyer à la console" Click="Dock_Click" Padding="10,6"/>
        </StackPanel>
        <TextBlock Text="Visionnez et placez les motifs ILDA pendant l’édition. La sélection reste synchronisée avec la console principale."
                   TextWrapping="Wrap" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <local:LibraryView x:Name="Browser"/>
  </DockPanel>
</Window>
