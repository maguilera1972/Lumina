<Window x:Class="Lumina.App.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nommer le motif"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        MinWidth="300">
  <StackPanel Margin="20">
    <TextBlock Text="Nom du motif :" Foreground="{StaticResource BoothMuted}" Margin="0,0,0,6"/>
    <TextBox x:Name="NameBox" Padding="6" Background="#121A26"
             Foreground="{StaticResource BoothText}"
             BorderBrush="#3AA8B8" BorderThickness="1"
             MinWidth="260"
             KeyDown="NameBox_KeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" Padding="12,6"/>
      <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="12,6"/>
    </StackPanel>
  </StackPanel>
</Window>
