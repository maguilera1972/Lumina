<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lumina.ico</ApplicationIcon>
    <RootNamespace>Lumina.App</RootNamespace>
    <AssemblyName>Lumina</AssemblyName>
    <Description>Création et lecture de shows laser ILDA pour Windows 11.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\splash.jpg" />
    <Resource Include="Assets\lumina-icon.png" />
    <Content Include="Assets\favicon.ico" Link="favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\favicon-32.png" Link="favicon-32.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumina.Core\Lumina.Core.csproj" />
    <ProjectReference Include="..\Lumina.Dac\Lumina.Dac.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
