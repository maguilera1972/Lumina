<UserControl x:Class="Lumina.App.FrameEditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Crosshair">
  <Border Background="#070B12"
          BorderBrush="#3AA8B8"
          BorderThickness="1"
          CornerRadius="6"
          ClipToBounds="True">
    <Grid>
      <!-- Drawing surface -->
      <Canvas x:Name="DrawCanvas"
              ClipToBounds="True"
              Background="Transparent"
              SizeChanged="DrawCanvas_SizeChanged"
              MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
              MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
              MouseRightButtonDown="Canvas_MouseRightButtonDown"
              MouseMove="Canvas_MouseMove"
              MouseLeave="Canvas_MouseLeave"/>

      <!-- Crosshair overlay: only visible when mouse is over in PEN mode -->
      <Line x:Name="CrossH" IsHitTestVisible="False"
            Stroke="#40E5FF" StrokeThickness="0.7" StrokeDashArray="4,3"
            Visibility="Collapsed"/>
      <Line x:Name="CrossV" IsHitTestVisible="False"
            Stroke="#40E5FF" StrokeThickness="0.7" StrokeDashArray="4,3"
            Visibility="Collapsed"/>

      <!-- Coordinates readout bottom-left -->
      <TextBlock x:Name="CoordText"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Foreground="#609BB4C4"
                 FontSize="10"
                 FontFamily="Consolas"
                 Margin="6,0,0,4"
                 IsHitTestVisible="False"/>
    </Grid>
  </Border>
</UserControl>
