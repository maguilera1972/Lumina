<UserControl x:Class="Lumina.App.WaveformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource BoothTrack}">
    <Grid>
      <Canvas x:Name="RulerCanvas" Height="24" VerticalAlignment="Top" Background="{DynamicResource BoothPanel}"/>
      <Canvas x:Name="WaveCanvas" Margin="0,24,0,0" Background="{DynamicResource BoothTrack}" ClipToBounds="True"
              SizeChanged="WaveCanvas_SizeChanged"
              MouseLeftButtonDown="WaveCanvas_MouseLeftButtonDown"/>
      <TextBlock x:Name="HintText"
                 Text="Chargez un MP3 ou un WAV pour afficher la forme d’onde et caler le laser dessus."
                 Foreground="{DynamicResource BoothMuted}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,24,0,0"
                 IsHitTestVisible="False"/>
    </Grid>
  </Border>
</UserControl>
