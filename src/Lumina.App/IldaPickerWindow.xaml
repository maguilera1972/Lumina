<Window x:Class="Lumina.App.IldaPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lumina.App"
        Title="Lumina — choisir les formes ILDA"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        Icon="pack://application:,,,/Assets/lumina-icon.png">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" Background="#F4F8FB" CornerRadius="14" Padding="14" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="SummaryText" Foreground="{StaticResource BoothInk}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <WrapPanel>
            <RadioButton x:Name="AnimationMode" GroupName="Mode"
                         Content="Animation complète (un clip)"
                         Foreground="{StaticResource BoothInk}" Margin="0,0,18,8" VerticalAlignment="Center"/>
            <RadioButton x:Name="ShapesMode" GroupName="Mode"
                         Content="Formes cochées (un clip par frame)"
                         Foreground="{StaticResource BoothInk}" Margin="0,0,18,8" VerticalAlignment="Center"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Tout cocher" Click="SelectAll_Click" Padding="10,6" Margin="0,0,8,0"/>
          <Button Content="Tout décocher" Click="SelectNone_Click" Padding="10,6" Margin="0,0,16,0"/>
          <Button Content="Ajouter à la timeline" Click="Add_Click" Padding="14,8" Margin="0,0,8,0" FontWeight="SemiBold"/>
          <Button Content="Annuler" Click="Cancel_Click" Padding="14,8"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="#F4F8FB" CornerRadius="14" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Éléments du fichier"
                     Foreground="{StaticResource BoothInk}" FontWeight="SemiBold" Margin="4,2,4,8"/>
          <ListBox x:Name="FrameList"
                   BorderThickness="0"
                   Background="Transparent"
                   Foreground="{StaticResource BoothInk}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   SelectionChanged="FrameList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BoothInk}"
                            Margin="2,0,8,0"/>
                  <local:FrameCanvas Grid.Column="1" Frame="{Binding Frame}" Width="72" Height="72"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BoothInk}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Stats}" Foreground="#44505A" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BoothPanel}" CornerRadius="12" Padding="10" Margin="0,10,0,0">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Right">
              <Button x:Name="PlayButton" Content="Lire" Click="Play_Click" Padding="10,6" Margin="0,0,8,0"/>
              <Button Content="Stop" Click="Stop_Click" Padding="10,6"/>
            </WrapPanel>
            <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ValueChanged="FrameSlider_ValueChanged"/>
          </DockPanel>
        </Border>
        <TextBlock x:Name="PreviewLabel" DockPanel.Dock="Top" Margin="4,0,4,8" FontWeight="SemiBold"/>
        <local:LaserPreview x:Name="Preview"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
