<UserControl x:Class="Lumina.App.IldaInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.App">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.2*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel>
      <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Text="Aucun fichier ILDA"
                 Foreground="{DynamicResource BoothMuted}" Margin="0,0,0,8"/>
      <DataGrid x:Name="FrameGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                SelectionMode="Single"
                SelectionChanged="FrameGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding IndexDisplay}" Width="40"/>
          <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Format" Binding="{Binding FormatLabel}" Width="110"/>
          <DataGridTextColumn Header="Points" Binding="{Binding PointCount}" Width="70"/>
          <DataGridTextColumn Header="Visibles" Binding="{Binding VisibleCount}" Width="70"/>
          <DataGridTextColumn Header="Blank" Binding="{Binding BlankedCount}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <local:LaserPreview x:Name="FramePreview"/>
      <StackPanel Grid.Row="1" Margin="0,12,0,0">
        <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="FrameSlider_ValueChanged"/>
        <TextBlock x:Name="StatsText" Foreground="{DynamicResource BoothText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   FontFamily="Consolas" FontSize="12"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
