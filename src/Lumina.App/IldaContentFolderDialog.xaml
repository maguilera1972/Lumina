<Window x:Class="Lumina.App.IldaContentFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Définir le dossier ILDA"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BoothBg}"
        Foreground="{StaticResource BoothText}"
        MinWidth="520">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
               Text="Ce dossier sera utilisé comme répertoire de départ pour l’import/inspection des shows .ild / .fra."
               TextWrapping="Wrap"
               Foreground="{StaticResource BoothMuted}"
               Margin="0,0,0,10"/>

    <TextBlock Grid.Row="1" Grid.Column="0"
               Text="Dossier ILDA :"
               Foreground="{StaticResource BoothMuted}"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

    <TextBox x:Name="FolderBox"
             Grid.Row="1" Grid.Column="1"
             Background="#121A26"
             Foreground="{StaticResource BoothText}"
             BorderBrush="#3AA8B8"
             BorderThickness="1"
             Padding="8,6"
             MinWidth="320"/>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Choisir un fichier .ild / .fra…"
              Click="Browse_Click"
              Padding="10,6"
              Margin="0,0,10,0"/>
      <Button Content="Effacer (laisser vide)"
              Click="Clear_Click"
              Padding="10,6"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Annuler" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
      <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="12,6"/>
    </StackPanel>
  </Grid>
</Window>

