<UserControl x:Class="Lumina.App.FrameEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lumina.App"
             Background="{StaticResource BoothBg}"
             Foreground="{StaticResource BoothText}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" MinWidth="140"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="180" MinWidth="140"/>
    </Grid.ColumnDefinitions>

    <!-- ══ Top toolbar (spans all columns) ════════════════════════════════ -->
    <Border Grid.Row="0" Grid.ColumnSpan="3"
            Background="{StaticResource BoothPanel}"
            CornerRadius="10" Margin="0,0,0,6" Padding="10,7">
      <DockPanel>

        <!-- Right side: undo/redo/clear -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0">
          <Button x:Name="UndoBtn" Content="↩ Annuler" Click="Undo_Click" Margin="4,0" Padding="8,5" ToolTip="Ctrl+Z"/>
          <Button x:Name="RedoBtn" Content="↪ Rétablir" Click="Redo_Click" Margin="4,0" Padding="8,5" ToolTip="Ctrl+Y"/>
          <Button Content="🗑 Effacer" Click="ClearPoints_Click" Margin="12,0,0,0" Padding="8,5"
                  Background="#4B1818" Foreground="White" ToolTip="Efface tous les points de la frame courante"/>
        </StackPanel>

        <!-- Left side: tool selector + blanked toggle -->
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Outil :" VerticalAlignment="Center" Foreground="{StaticResource BoothMuted}" Margin="0,0,8,0"/>
          <ToggleButton x:Name="PenBtn" Content="✏ Crayon" Checked="PenBtn_Checked"
                        Padding="8,5" Margin="0,0,4,0" IsChecked="True"/>
          <ToggleButton x:Name="MoveBtn" Content="✋ Déplacer" Checked="MoveBtn_Checked"
                        Padding="8,5" Margin="0,0,4,0"/>
          <ToggleButton x:Name="EraseBtn" Content="◌ Gomme" Checked="EraseBtn_Checked"
                        Padding="8,5" Margin="0,0,16,0"/>

          <CheckBox x:Name="BlankedCheck" Content="Blank (saut sans tracé)"
                    VerticalAlignment="Center" Margin="0,0,16,0"
                    Checked="BlankedCheck_Changed" Unchecked="BlankedCheck_Changed"/>

          <TextBlock Text="Couleur :" VerticalAlignment="Center" Foreground="{StaticResource BoothMuted}" Margin="0,0,6,0"/>
          <!-- Quick color swatches -->
          <ItemsControl x:Name="SwatchList" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="22" Height="22" Margin="2,0"
                        Tag="{Binding}" Click="Swatch_Click"
                        ToolTip="{Binding Name}">
                  <Button.Background><SolidColorBrush Color="{Binding Color}"/></Button.Background>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Rectangle x:Name="ActiveColorRect" Width="22" Height="22" Margin="6,0,0,0"
                     Stroke="#3AA8B8" StrokeThickness="1" RadiusX="4" RadiusY="4"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ══ Left panel : frame list ════════════════════════════════════════ -->
    <Border Grid.Row="1" Grid.Column="0"
            Background="{StaticResource BoothPanel}"
            CornerRadius="10" Margin="0,0,6,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Frames" FontSize="12"
                   Foreground="{StaticResource BoothMuted}" Margin="0,0,0,6"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="+" Click="AddFrame_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Nouvelle frame"/>
          <Button Content="⎘" Click="DupFrame_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Dupliquer"/>
          <Button Content="↑" Click="FrameUp_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Monter"/>
          <Button Content="↓" Click="FrameDown_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Descendre"/>
          <Button Content="✕" Click="DelFrame_Click" Padding="8,4" Background="#4B1818" Foreground="White" ToolTip="Supprimer"/>
        </StackPanel>
        <ListBox x:Name="FrameListBox" SelectionChanged="FrameListBox_SelectionChanged"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource BoothText}"/>
      </DockPanel>
    </Border>

    <!-- ══ Center : drawing canvas ════════════════════════════════════════ -->
    <local:FrameEditorCanvas x:Name="EditorCanvas"
                              Grid.Row="1" Grid.Column="1"/>

    <!-- ══ Right panel : point inspector ══════════════════════════════════ -->
    <Border Grid.Row="1" Grid.Column="2"
            Background="{StaticResource BoothPanel}"
            CornerRadius="10" Margin="6,0,0,0" Padding="8">
      <StackPanel>
        <TextBlock Text="Infos frame" FontSize="12"
                   Foreground="{StaticResource BoothMuted}" Margin="0,0,0,6"/>

        <TextBlock Text="Nom :" FontSize="11" Foreground="{StaticResource BoothMuted}" Margin="0,0,0,2"/>
        <TextBox x:Name="FrameNameBox" TextChanged="FrameNameBox_TextChanged"
                 Background="#121A26" Foreground="{StaticResource BoothText}"
                 BorderBrush="#3AA8B8" BorderThickness="1" Padding="4" Margin="0,0,0,8"/>

        <TextBlock x:Name="PointCountText" FontSize="11"
                   Foreground="{StaticResource BoothMuted}" Margin="0,0,0,4"/>

        <Separator Background="#1E3040" Margin="0,6"/>

        <TextBlock Text="Aperçu frame" FontSize="11"
                   Foreground="{StaticResource BoothMuted}" Margin="0,0,0,4"/>
        <local:LaserPreview x:Name="MiniPreview" Height="120"/>

        <Separator Background="#1E3040" Margin="0,8"/>

        <TextBlock Text="Aide" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource BoothMuted}" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#609BB4C4">
          <Run FontWeight="Bold">Crayon :</Run> clic gauche = ajouter un point,&#x0a;clic droit = supprimer le dernier.&#x0a;&#x0a;<Run FontWeight="Bold">Déplacer :</Run> glisser un point.&#x0a;&#x0a;<Run FontWeight="Bold">Gomme :</Run> clic sur un point pour l'effacer.&#x0a;&#x0a;<Run FontWeight="Bold">Blank :</Run> segment sans tracé (saut).&#x0a;&#x0a;Ctrl+Z / Ctrl+Y pour annuler/rétablir.
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- ══ Status bar ══════════════════════════════════════════════════════ -->
    <Border Grid.Row="2" Grid.ColumnSpan="3"
            Background="{StaticResource BoothPanel}"
            CornerRadius="8" Margin="0,6,0,0" Padding="10,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✔ Sauvegarder dans la bibliothèque"
                Click="SaveToLibrary_Click" Padding="10,5" Margin="8,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="📤 Exporter ILDA…"
                Click="ExportIlda_Click" Padding="10,5"/>
        <TextBlock x:Name="StatusBar" VerticalAlignment="Center"
                   Foreground="{StaticResource BoothMuted}" FontSize="11"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
