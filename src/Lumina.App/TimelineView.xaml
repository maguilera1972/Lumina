<UserControl x:Class="Lumina.App.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="24"/>
      <RowDefinition Height="32"/>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="AUDIO" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" Margin="8,0"/>
    <Canvas x:Name="AudioTrack" Grid.Row="0" Grid.Column="1" Background="{DynamicResource BoothTrack}"
            MouseLeftButtonDown="Track_MouseLeftButtonDown"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="SCÈNES" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" Margin="8,0"/>
    <Canvas x:Name="LaserTrack" Grid.Row="1" Grid.Column="1" Background="{DynamicResource BoothTrack}" ClipToBounds="True"
            SizeChanged="LaserTrack_SizeChanged"
            MouseLeftButtonDown="Track_MouseLeftButtonDown"/>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="CLIPS" Foreground="{DynamicResource BoothMuted}" VerticalAlignment="Center" Margin="8,0"/>
    <Canvas x:Name="ClipTrack" Grid.Row="2" Grid.Column="1" Background="{DynamicResource BoothTrack}" ClipToBounds="True"
            MouseLeftButtonDown="ClipTrack_MouseLeftButtonDown"/>

    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource BoothPanel}" Padding="8" CornerRadius="12">
      <WrapPanel>
        <Button Content="Ajouter scène" Click="Add_Click" Margin="0,0,8,0" Padding="8,4"/>
        <Button Content="Supprimer" Click="Remove_Click" Margin="0,0,8,0" Padding="8,4"/>
        <Button Content="«" Click="Left_Click" Margin="0,0,4,0" Width="32" Padding="4"/>
        <Button Content="»" Click="Right_Click" Margin="0,0,8,0" Width="32" Padding="4"/>
        <Button Content="Compacter" Click="Compact_Click" Margin="0,0,12,0" Padding="8,4"/>
        <TextBlock Text="Nom" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BoothMuted}"/>
        <TextBox x:Name="NameBox" Width="120" Margin="0,0,8,0" LostFocus="Fields_Changed"/>
        <TextBlock Text="Début s" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BoothMuted}"/>
        <TextBox x:Name="StartBox" Width="56" Margin="0,0,8,0" LostFocus="Fields_Changed"/>
        <TextBlock Text="Durée s" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BoothMuted}"/>
        <TextBox x:Name="DurationBox" Width="56" Margin="0,0,8,0" LostFocus="Fields_Changed"/>
        <TextBlock Text="Frames" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BoothMuted}"/>
        <TextBox x:Name="FrameStartBox" Width="40" Margin="0,0,4,0" LostFocus="Fields_Changed"/>
        <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox x:Name="FrameEndBox" Width="40" LostFocus="Fields_Changed"/>
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>
